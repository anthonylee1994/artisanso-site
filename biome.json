{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["**", "!dist", "!pnpm-lock.yaml"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 200
    },
    "javascript": {
        "formatter": {
            "trailingCommas": "es5",
            "bracketSpacing": false,
            "arrowParentheses": "asNeeded"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "assist": {
        "enabled": false
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "none",
            "nursery": {
                "useTailwindSortedClasses": {
                    "level": "error",
                    "fix": "safe"
                }
            }
        }
    },
    "json": {
        "formatter": {
            "bracketSpacing": false
        }
    }
}
